<UserControl x:Class="LapDock.Views.Tabs.ShelfTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LapDock.Controls"
             Foreground="{StaticResource TextBrush}">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelTileBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource TileRadius}"/>
        </Style>
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="{StaticResource PanelFillBrush}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,6,6,0"/>
        </Style>
        <Style x:Key="TextLink" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <!-- One tile per item: its icon, name and size -->
        <Style x:Key="Tile" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="{Binding Name}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Tile" Width="92" Height="112" Background="Transparent" CornerRadius="12" Margin="2" Padding="6,11,6,6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="#12FFFFFF"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="{StaticResource PanelFillBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="TileTemplate">
            <StackPanel>
                <Grid Width="38" Height="38" HorizontalAlignment="Center">
                    <Image x:Name="Icon" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <controls:LineIcon x:Name="Glyph" Icon="{Binding Glyph}" Width="26" Height="26" Foreground="{StaticResource MutedBrush}" Visibility="Collapsed"/>
                </Grid>
                <TextBlock Text="{Binding Name}" FontSize="11.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="31"
                           TextAlignment="Center" Margin="0,7,0,1"/>
                <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="4,8,0,0">
            <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="Clear shelf" Style="{StaticResource TextLink}"
                    ToolTip="Empties the shelf (the files themselves stay where they are)" Click="Clear_Click"/>
            <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <Grid Height="296">
            <!-- Empty: the whole shelf is a drop zone -->
            <Border x:Name="EmptyZone" Style="{StaticResource Card}">
                <Grid>
                    <Rectangle x:Name="EmptyDash" RadiusX="16" RadiusY="16" Stroke="{StaticResource FillHoverBrush}" StrokeThickness="1.5"
                               StrokeDashArray="5 4" Margin="1"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="340">
                        <controls:LineIcon x:Name="EmptyIcon" Icon="shelf" Width="40" Height="40" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="EmptyTitle" Text="Drop files here" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,5"/>
                        <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center"
                                   Text="Drag files, links or text onto the notch to keep them for later. Drag them back out into any app, share them, or scan them to your phone."/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Items, and the selected one's details -->
            <Grid x:Name="Filled" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="302"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="ListCard" Style="{StaticResource Card}" Padding="3" BorderThickness="1.5" BorderBrush="Transparent">
                    <ListBox x:Name="List" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Tile}"
                             ItemTemplate="{StaticResource TileTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.ScrollUnit="Pixel" SelectionChanged="List_SelectionChanged" KeyDown="List_KeyDown"
                             MouseDoubleClick="List_MouseDoubleClick" PreviewMouseLeftButtonDown="List_PreviewMouseDown" PreviewMouseMove="List_PreviewMouseMove">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    </ListBox>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0" Padding="14,12">
                    <Grid>
                        <DockPanel x:Name="Details">
                            <WrapPanel DockPanel.Dock="Bottom">
                                <Button x:Name="OpenButton" Style="{StaticResource Action}" Click="Open_Click" ToolTip="Open it (Enter)">
                                    <TextBlock Text="Open"/>
                                </Button>
                                <Button x:Name="FolderButton" Style="{StaticResource Action}" Click="Folder_Click" ToolTip="Show it in its folder">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:LineIcon Icon="folder" Width="14" Height="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="Folder"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ShareButton" Style="{StaticResource Action}" Click="Share_Click" ToolTip="Share with Windows: nearby devices, Phone Link, mail, apps">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:LineIcon Icon="share" Width="14" Height="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="Share"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="QrButton" Style="{StaticResource Action}" Click="Qr_Click" ToolTip="A QR code: scan it with your phone to get this">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:LineIcon Icon="qr" Width="14" Height="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="QR"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Action}" Click="Copy_Click" ToolTip="Copy it, to paste anywhere">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:LineIcon Icon="copy" Width="14" Height="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="Copy"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Action}" Click="Remove_Click" ToolTip="Take it off the shelf (Del)">
                                    <controls:LineIcon Icon="trash" Width="14" Height="14" Margin="0,2"/>
                                </Button>
                            </WrapPanel>
                            <StackPanel>
                                <Grid Width="44" Height="44" HorizontalAlignment="Left">
                                    <Image x:Name="DetailIcon" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <controls:LineIcon x:Name="DetailGlyph" Width="30" Height="30" Foreground="{StaticResource MutedBrush}"/>
                                </Grid>
                                <TextBlock x:Name="DetailName" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                           MaxHeight="54" Margin="0,10,0,3"/>
                                <TextBlock x:Name="DetailMeta" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" MaxHeight="46"/>
                            </StackPanel>
                        </DockPanel>

                        <StackPanel x:Name="QrPanel" VerticalAlignment="Center" Visibility="Collapsed">
                            <Border Background="White" CornerRadius="12" Padding="6" HorizontalAlignment="Center">
                                <Image x:Name="QrImage" Width="128" Height="128" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>
                            <TextBlock x:Name="QrText" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,4"/>
                            <Button Content="Done" Style="{StaticResource Action}" HorizontalAlignment="Center" Margin="0,4,0,0" Click="QrDone_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
