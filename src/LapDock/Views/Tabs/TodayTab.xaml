<UserControl x:Class="LapDock.Views.Tabs.TodayTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LapDock.Controls"
             Foreground="{StaticResource TextBrush}">
    <UserControl.Resources>
        <Style x:Key="TodayCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelTileBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource TileRadius}"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
        <Style x:Key="TextLink" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

        <!-- Round to-do check: green with a tick when done. -->
        <Style x:Key="TodoCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="8" BorderThickness="1.5"
                                BorderBrush="{StaticResource MutedBrush}" Background="Transparent">
                            <TextBlock x:Name="Tick" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="9" Foreground="Black"
                                       HorizontalAlignment="Center" Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Date, time, weather · this week -->
        <Border Style="{StaticResource TodayCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel MinWidth="150">
                    <TextBlock x:Name="RangeText" Style="{StaticResource CardTitle}"/>
                    <TextBlock x:Name="BigTime" Style="{StaticResource BigNumber}" FontSize="52" Margin="-2,-4,0,-4"/>
                    <TextBlock x:Name="DayLine" FontSize="13" FontWeight="SemiBold"/>
                    <StackPanel x:Name="WeatherRow" Orientation="Horizontal" Margin="0,3,0,0" Visibility="Collapsed">
                        <controls:LineIcon Icon="weather" Width="15" Height="15" Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="WeatherLine" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Import .ics…" Style="{StaticResource TextLink}" Margin="0,-3,-6,0"
                                ToolTip="Add events from a calendar file (Google / Outlook export)" Click="ImportIcs_Click"/>
                        <TextBlock Text="This week" Style="{StaticResource CardTitle}"/>
                    </DockPanel>
                    <UniformGrid x:Name="WeekStrip" Columns="7" Margin="0,8,0,8"/>
                    <StackPanel x:Name="Agenda"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Quick timer -->
            <Border Style="{StaticResource TodayCard}" Margin="0,0,10,0">
                <StackPanel>
                    <controls:Ring x:Name="TimerRing" Width="112" Height="112" StrokeWidth="7" Progress="1"
                                   RingBrush="{StaticResource AccentBrush}" HorizontalAlignment="Center">
                        <TextBlock x:Name="TimerText" Style="{StaticResource BigNumber}" FontSize="26"/>
                    </controls:Ring>
                    <StackPanel x:Name="Presets" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,6"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="StartButton" Content="Start" Style="{StaticResource PrimaryPill}" Padding="14,5" FontSize="12" Click="StartPause_Click"/>
                        <Button Content="Reset" Style="{StaticResource PillButton}" Background="{StaticResource PanelFillBrush}" Padding="14,5" FontSize="12" Margin="6,0,0,0" Click="Reset_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- To-dos and reminders -->
            <Border Grid.Column="1" Style="{StaticResource TodayCard}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock x:Name="TodoCount" DockPanel.Dock="Right" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="To-do" Style="{StaticResource CardTitle}"/>
                    </DockPanel>
                    <Button DockPanel.Dock="Bottom" Content="New reminder…" Style="{StaticResource TextLink}" HorizontalAlignment="Left" Margin="-6,4,0,0"
                            ToolTip="A to-do ending in @time, e.g. &quot;Call mom @18:30&quot;" Click="NewReminder_Click"/>
                    <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <TextBox x:Name="TodoInput" Background="{StaticResource PanelInputBrush}" Foreground="{StaticResource TextBrush}"
                                 CaretBrush="{StaticResource TextBrush}" BorderThickness="0" Padding="8,6" FontSize="12.5"
                                 KeyDown="TodoInput_KeyDown" TextChanged="TodoInput_Changed"
                                 GotKeyboardFocus="TodoInput_Changed" LostKeyboardFocus="TodoInput_Changed"/>
                        <TextBlock x:Name="TodoHint" Text="+ Add a to-do" FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                                   Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <ScrollViewer MaxHeight="128" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TodoList"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
