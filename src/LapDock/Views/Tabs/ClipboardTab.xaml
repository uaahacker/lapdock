<UserControl x:Class="LapDock.Views.Tabs.ClipboardTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LapDock.Controls"
             xmlns:svc="clr-namespace:LapDock.Services"
             Foreground="{StaticResource TextBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
        <Style x:Key="ClipCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelTileBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource TileRadius}"/>
        </Style>
        <Style x:Key="FilterChip" TargetType="Button" BasedOn="{StaticResource OptionPill}">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="{StaticResource PanelFillBrush}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,6,6,0"/>
        </Style>
        <Style x:Key="TextLink" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>


        <DataTemplate DataType="{x:Type svc:ClipItem}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                <controls:LineIcon DockPanel.Dock="Right" Icon="pin" Width="13" Height="13" Foreground="{StaticResource AccentBrush}"
                                   Margin="6,0,0,0" Visibility="{Binding Pinned, Converter={StaticResource Vis}}"/>
                <Border DockPanel.Dock="Left" Width="34" Height="22" CornerRadius="4" Margin="0,0,8,0"
                        Visibility="{Binding IsImage, Converter={StaticResource Vis}}">
                    <Border.Background><ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"/></Border.Background>
                </Border>
                <TextBlock x:Name="Line" Text="{Binding Preview}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLink}" Value="True">
                    <Setter TargetName="Line" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- Status line, as in the reel: shortcut • items • pinned -->
        <DockPanel DockPanel.Dock="Bottom" Margin="4,8,0,0">
            <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="Clear history" Style="{StaticResource TextLink}"
                    ToolTip="Deletes everything except pinned items" Click="Clear_Click"/>
            <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Search -->
        <Border DockPanel.Dock="Top" Style="{StaticResource ClipCard}" CornerRadius="12" Padding="12,0">
            <DockPanel Height="36">
                <controls:LineIcon Icon="search" Width="16" Height="16" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0"/>
                <Grid>
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{StaticResource TextBrush}"
                             CaretBrush="{StaticResource TextBrush}" FontSize="13" VerticalContentAlignment="Center"
                             TextChanged="Search_TextChanged" PreviewKeyDown="Search_PreviewKeyDown"/>
                    <TextBlock x:Name="SearchHint" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </DockPanel>
        </Border>

        <StackPanel x:Name="Chips" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,8,0,8"/>

        <Grid Height="296">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource ClipCard}" Padding="4">
                <Grid>
                    <ListBox x:Name="List" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ListRow}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"
                             SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_MouseDoubleClick" KeyDown="List_KeyDown"/>
                    <TextBlock x:Name="ListEmpty" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="16,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource ClipCard}" Margin="10,0,0,0" Padding="14,12">
                <DockPanel>
                    <WrapPanel x:Name="Actions" DockPanel.Dock="Bottom">
                        <Button Style="{StaticResource Action}" Click="Copy_Click" ToolTip="Put it back on the clipboard (Enter pastes it)">
                            <StackPanel Orientation="Horizontal">
                                <controls:LineIcon Icon="copy" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock x:Name="CopyLabel" Text="Copy"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Action}" Click="Pin_Click" ToolTip="Pinned items stay at the top and are never cleared">
                            <StackPanel Orientation="Horizontal">
                                <controls:LineIcon Icon="pin" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock x:Name="PinLabel" Text="Pin"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="QrButton" Style="{StaticResource Action}" Click="Qr_Click" ToolTip="Show as a QR code to scan with your phone">
                            <StackPanel Orientation="Horizontal">
                                <controls:LineIcon Icon="qr" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock x:Name="QrLabel" Text="QR"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SnippetButton" Style="{StaticResource Action}" Click="Snippet_Click" ToolTip="Keep it as a snippet: search for it in Apps and paste it any time">
                            <StackPanel Orientation="Horizontal">
                                <controls:LineIcon Icon="clipboard" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock x:Name="SnippetLabel" Text="Snippet"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpenButton" Style="{StaticResource Action}" Click="Open_Click" ToolTip="Open in your browser">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="Open"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Action}" Click="Delete_Click" ToolTip="Delete (Del)">
                            <controls:LineIcon Icon="trash" Width="14" Height="14" Margin="0,2"/>
                        </Button>
                    </WrapPanel>
                    <TextBlock x:Name="PreviewMeta" DockPanel.Dock="Top" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                    <Grid>
                        <TextBox x:Name="PreviewText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" FontSize="12.5"
                                 CaretBrush="{StaticResource TextBrush}" SelectionBrush="{StaticResource AccentBrush}" Padding="-2,0,0,0"/>
                        <Border x:Name="PreviewImageHost" CornerRadius="10" ClipToBounds="True">
                            <Image x:Name="PreviewImage" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top"/>
                        </Border>
                        <Border x:Name="QrHost" Background="White" CornerRadius="12" Padding="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="QrImage" Width="132" Height="132" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>
                        <TextBlock x:Name="PreviewEmpty" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   TextAlignment="Center" VerticalAlignment="Center" Margin="12,0"/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
