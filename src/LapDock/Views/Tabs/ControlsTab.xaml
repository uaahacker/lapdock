<UserControl x:Class="LapDock.Views.Tabs.ControlsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LapDock.Controls">
    <UserControl.Resources>
        <!-- Quick-settings tile: icon circle (green when on), title, live subtitle. Built in code-behind. -->
        <Style x:Key="QuickTile" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{StaticResource PanelTileBrush}" CornerRadius="{StaticResource TileRadius}"/>
                            <Border x:Name="Hover" Background="White" Opacity="0" CornerRadius="{StaticResource TileRadius}"/>
                            <ContentPresenter Margin="14,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.05"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.12"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <UniformGrid x:Name="TileGrid" Columns="2" Margin="0,0,-10,0"/>

        <!-- Master volume -->
        <Border Background="{StaticResource PanelTileBrush}" CornerRadius="{StaticResource TileRadius}" Padding="10,8,16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="MuteButton" Style="{StaticResource RoundButton}" Background="{StaticResource PanelFillBrush}" Width="38" Height="38"
                        ToolTip="Mute / unmute" Click="Mute_Click">
                    <controls:LineIcon x:Name="MuteIcon" Icon="volume" Width="18" Height="18"/>
                </Button>
                <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="100"
                        IsMoveToPointEnabled="True" Margin="12,0" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                <TextBlock x:Name="VolumeValue" Grid.Column="2" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Music strip (SMTC) -->
        <controls:MusicCard x:Name="Music" Background="{StaticResource PanelTileBrush}" Padding="14,12" Margin="0,10,0,0"/>
    </StackPanel>
</UserControl>
