<UserControl x:Class="LapDock.Views.Tabs.AppsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LapDock.Controls"
             xmlns:local="clr-namespace:LapDock.Views.Tabs"
             Foreground="{StaticResource TextBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelTileBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource TileRadius}"/>
        </Style>
        <!-- Section headers sit in the list but can't be hovered or selected. -->
        <Style x:Key="LaunchRow" TargetType="ListBoxItem" BasedOn="{StaticResource ListRow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                    <Setter Property="IsHitTestVisible" Value="False"/>
                    <Setter Property="Focusable" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type local:LaunchItem}">
            <Grid>
                <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                           Margin="0,6,0,0" Visibility="{Binding IsHeader, Converter={StaticResource Vis}}"/>
                <DockPanel Visibility="{Binding IsEntry, Converter={StaticResource Vis}}">
                    <Button x:Name="Star" DockPanel.Dock="Right" Style="{StaticResource ChromeButton}"
                            Width="28" Height="28" Margin="4,0,-4,0" ToolTip="Favourite: keep it at the top"
                            Visibility="{Binding IsApp, Converter={StaticResource Vis}}" Click="Star_Click">
                        <controls:LineIcon Icon="star" Width="15" Height="15"/>
                    </Button>
                    <Button DockPanel.Dock="Right" Content="&#xE711;" Style="{StaticResource ChromeButton}"
                            Width="28" Height="28" FontSize="9" Margin="4,0,-4,0" ToolTip="Remove snippet"
                            Visibility="{Binding IsSnippet, Converter={StaticResource Vis}}" Click="RemoveSnippet_Click"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding KindLabel}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <!-- The app's own icon, as Start shows it. The grey tile is only for things without one (snippets). -->
                    <Grid DockPanel.Dock="Left" Width="28" Height="28" Margin="0,0,12,0">
                        <Border x:Name="Placeholder" Background="{StaticResource PanelFillBrush}" CornerRadius="7">
                            <Grid>
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                                <controls:LineIcon Icon="{Binding IconName}" Width="15" Height="15" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>
                        </Border>
                        <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasSubtitle, Converter={StaticResource Vis}}"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFavourite}" Value="True">
                    <Setter TargetName="Star" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                    <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="4,8,0,0"
                   Text="Enter opens  •  ↑ ↓ to move  •  Esc closes"/>

        <DockPanel DockPanel.Dock="Top">
            <Button x:Name="FavouritesOnly" DockPanel.Dock="Right" Style="{StaticResource RoundButton}"
                    Background="{StaticResource PanelTileBrush}" Width="36" Height="36" Margin="8,0,0,0"
                    ToolTip="Show favourites only" Click="FavouritesOnly_Click">
                <controls:LineIcon Icon="star" Width="17" Height="17"/>
            </Button>
            <Border Style="{StaticResource Card}" CornerRadius="12" Padding="12,0">
                <DockPanel Height="36">
                    <controls:LineIcon Icon="search" Width="16" Height="16" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0"/>
                    <Grid>
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{StaticResource TextBrush}"
                                 CaretBrush="{StaticResource TextBrush}" FontSize="13" VerticalContentAlignment="Center"
                                 TextChanged="Search_TextChanged" PreviewKeyDown="Search_PreviewKeyDown"/>
                        <TextBlock x:Name="SearchHint" Text="Search apps, files and snippets…" FontSize="13" Foreground="{StaticResource MutedBrush}"
                                   Margin="2,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </DockPanel>
            </Border>
        </DockPanel>

        <Border Style="{StaticResource Card}" Padding="4" Margin="0,8,0,0" Height="352">
            <Grid>
                <ListBox x:Name="List" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource LaunchRow}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"
                         MouseUp="List_MouseUp" KeyDown="List_KeyDown"/>
                <TextBlock x:Name="Empty" FontSize="12.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="24,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
