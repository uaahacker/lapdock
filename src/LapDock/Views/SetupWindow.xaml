<Window x:Class="LapDock.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LapDock Setup" Width="460" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Icon="pack://application:,,,/LapDock;component/Assets/LapDock.ico"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Border Background="{StaticResource PanelBrush}" CornerRadius="{StaticResource PanelRadius}"
            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="28,24,28,24"
            MouseLeftButtonDown="Drag">
        <StackPanel>
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/LapDock;component/Assets/LapDock-256.png" Width="56" Height="56"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VersionText" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="&#xE711;" Style="{StaticResource ChromeButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        ToolTip="Close" Click="Close_Click"/>
            </Grid>

            <TextBlock x:Name="Message" FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,18,0,16" LineHeight="19"/>

            <StackPanel x:Name="InstallOptions">
                <CheckBox x:Name="AutostartBox" Style="{StaticResource Switch}" Content="Start LapDock when I sign in" IsChecked="True"/>
                <CheckBox x:Name="DesktopBox" Style="{StaticResource Switch}" Content="Add a desktop shortcut"/>
            </StackPanel>
            <StackPanel x:Name="UninstallOptions">
                <CheckBox x:Name="RemoveDataBox" Style="{StaticResource Switch}" Content="Also delete my LapDock data"/>
            </StackPanel>

            <TextBlock x:Name="Note" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <TextBlock x:Name="Status" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="SecondaryButton" Style="{StaticResource PillButton}" Padding="16,8" Click="Secondary_Click"/>
                <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryPill}" Padding="20,8" Margin="8,0,0,0" Click="Primary_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
