<Window x:Class="LapDock.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LapDock.Controls"
        Title="LapDock Settings" Width="560" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" Opacity="0"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,20,0,10"/>
        </Style>

        <Style x:Key="ShortcutBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FillBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Border Background="{StaticResource PanelBrush}" CornerRadius="{StaticResource PanelRadius}"
            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="24,18,24,20"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.97" ScaleY="0.97"/>
        </Border.RenderTransform>
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal">
                    <controls:LineIcon Icon="settings" Width="22" Height="22" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="&#xE711;" Style="{StaticResource ChromeButton}" HorizontalAlignment="Right" ToolTip="Close (Esc)" Click="Close_Click"/>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-12,0" Padding="0,0,12,0">
            <StackPanel>
            <TextBlock Text="Display" Style="{StaticResource Section}"/>
            <WrapPanel x:Name="Displays"/>

            <TextBlock Text="Weather" Style="{StaticResource Section}"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Apply" Style="{StaticResource PrimaryPill}" Padding="16,6" FontSize="12" Margin="8,0,0,0" Click="ApplyCity_Click"/>
                <TextBox x:Name="CityBox" Style="{StaticResource ShortcutBox}"/>
            </DockPanel>
            <TextBlock x:Name="CityStatus" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"
                       Text="Your city, for the weather on Today. Press Enter or Apply."/>

            <TextBlock Text="Shortcut to open Settings" Style="{StaticResource Section}"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Apply" Style="{StaticResource PrimaryPill}" Padding="16,6" FontSize="12" Margin="8,0,0,0" Click="ApplyHotkey_Click"/>
                <TextBox x:Name="HotkeyBox" Style="{StaticResource ShortcutBox}"/>
            </DockPanel>
            <TextBlock x:Name="HotkeyStatus" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"
                       Text="For example Ctrl+Alt+D or Ctrl+Shift+F12. Press Enter or Apply to save."/>

            <TextBlock Text="Clipboard history" Style="{StaticResource Section}"/>
            <CheckBox Style="{StaticResource Switch}" Content="Keep a history of what you copy" IsChecked="{Binding ClipboardHistory}" Click="Changed_Click"/>
            <TextBlock Text="Shortcut to open it" FontSize="12.5" Margin="0,4,0,6"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Apply" Style="{StaticResource PrimaryPill}" Padding="16,6" FontSize="12" Margin="8,0,0,0" Click="ApplyClipHotkey_Click"/>
                <TextBox x:Name="ClipHotkeyBox" Style="{StaticResource ShortcutBox}"/>
            </DockPanel>
            <TextBlock x:Name="ClipHotkeyStatus" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Opens the notch on Clipboard. While it's set, apps don't get their own Ctrl+Shift+V (paste as plain text)."/>

            <TextBlock Text="Show in the notch" Style="{StaticResource Section}"/>
            <CheckBox Style="{StaticResource Switch}" Content="Clock" IsChecked="{Binding ShowClock}" Click="Changed_Click"/>
            <CheckBox Style="{StaticResource Switch}" Content="Battery" IsChecked="{Binding ShowBattery}" Click="Changed_Click"/>
            <CheckBox Style="{StaticResource Switch}" Content="Microphone in use" IsChecked="{Binding MicrophoneIndicator}" Click="Changed_Click"/>
            <CheckBox Style="{StaticResource Switch}" Content="Camera in use" IsChecked="{Binding CameraIndicator}" Click="Changed_Click"/>
            <CheckBox Style="{StaticResource Switch}" Content="Music" IsChecked="{Binding MediaControls}" Click="Changed_Click"/>
            <CheckBox Style="{StaticResource Switch}" Content="Live messages (charging, volume, screenshot saved…)" IsChecked="{Binding DynamicNotifications}" Click="Changed_Click"/>
            <TextBlock FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Text="Turning Battery, Microphone, Camera or Music back on takes effect the next time LapDock starts."/>

            <TextBlock Text="LapDock" Style="{StaticResource Section}"/>
            <CheckBox x:Name="AutostartBox" Style="{StaticResource Switch}" Content="Start LapDock when I sign in" Click="Autostart_Click"/>
            <DockPanel Margin="0,2,0,0">
                <Button x:Name="UninstallButton" DockPanel.Dock="Right" Content="Uninstall…" Style="{StaticResource PillButton}"
                        Padding="12,5" FontSize="12" Click="Uninstall_Click"/>
                <TextBlock x:Name="AboutText" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
            </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
