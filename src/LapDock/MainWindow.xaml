<Window x:Class="LapDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LapDock.Controls"
        xmlns:tabs="clr-namespace:LapDock.Views.Tabs"
        Title="LapDock" Width="600" Height="64"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SmallTile" TargetType="Button" BasedOn="{StaticResource ActionTile}">
            <Setter Property="Height" Value="58"/>
            <Setter Property="Background" Value="{StaticResource PanelFillBrush}"/>
        </Style>

        <!-- Status chips in the top row (battery, privacy) -->
        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="-8,6,0,0"/>
        </Style>


        <!-- Tab bar: a row of small pills; the selected one sits on a lighter fill. -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <!-- Icon-only tabs; the selected one also shows its name (Tag = icon name). -->
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Chip" Background="Transparent" CornerRadius="9" Padding="10,6" Margin="2,0"
                                ToolTip="{TemplateBinding Header}">
                            <StackPanel Orientation="Horizontal">
                                <controls:LineIcon Icon="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="16" Height="16"/>
                                <ContentPresenter x:Name="Label" ContentSource="Header" VerticalAlignment="Center" Margin="7,0,1,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource PanelFillBrush}"/>
                                <Setter TargetName="Chip" Property="ToolTip" Value="{x:Null}"/>
                                <Setter TargetName="Label" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shell for tabs that later phases fill in. -->
        <Style x:Key="ComingSoon" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,28"/>
        </Style>
    </Window.Resources>

    <!-- The window is fully transparent (and so click-through); only the island is drawn.
         Three states share one black pill: Peek (collapsed), Activity (short-lived event), Expanded (hover). -->
    <Grid x:Name="Island" HorizontalAlignment="Center" VerticalAlignment="Top"
          MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
          AllowDrop="True" DragEnter="Island_DragOver" DragOver="Island_DragOver" DragLeave="Island_DragLeave" Drop="Island_Drop">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Settings…" Click="Settings_Click"/>
                <MenuItem Header="Move to next display" Click="NextDisplay_Click"/>
                <MenuItem Header="Quit LapDock" Click="Quit_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- The black shape itself: flush with the screen's top edge, curved shoulders, round bottom. -->
        <controls:NotchShape x:Name="Pill" Width="190" Height="32" HorizontalAlignment="Center" VerticalAlignment="Top"/>

        <!-- ═══════════ PEEK: collapsed notch ═══════════ -->
        <Grid x:Name="Peek" MinWidth="190" Height="32" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="18"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="14,0,0,1" VerticalAlignment="Center">
                <!-- Nova, the island's face -->
                <Viewbox Width="19" Height="20.5" Margin="0,1,8,0">
                    <controls:CompanionHead x:Name="PeekNova" ToolTip="{x:Null}"/>
                </Viewbox>
                <Border x:Name="PeekArt" Width="18" Height="18" CornerRadius="4" Margin="0,0,8,0" Visibility="Collapsed">
                    <Border.Background><ImageBrush x:Name="PeekArtBrush" Stretch="UniformToFill"/></Border.Background>
                </Border>
                <TextBlock x:Name="PeekTitle" MaxWidth="150" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
                <TextBlock x:Name="PeekTime" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <!-- A live activity: timer, focus session, call, download -->
                <StackPanel x:Name="PeekLive" Orientation="Horizontal" Visibility="Collapsed">
                    <controls:LineIcon x:Name="PeekLiveIcon" Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PeekLiveLabel" MaxWidth="150" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,18,1" VerticalAlignment="Center">
                <TextBlock x:Name="PeekLiveValue" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" MinWidth="34"
                           TextAlignment="Right" Typography.NumeralAlignment="Tabular" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                <!-- Music bars: they follow what's actually playing (the output's level), centred like a waveform -->
                <controls:MusicBars x:Name="PeekEq" Fill="{StaticResource AccentBrush}" Margin="0,0,9,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                <!-- iOS privacy dots: green = camera, orange = microphone -->
                <Ellipse x:Name="PeekCamDot" Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                <Ellipse x:Name="PeekMicDot" Width="7" Height="7" Fill="{StaticResource OrangeBrush}" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                <StackPanel x:Name="PeekBattery" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock x:Name="PeekBatteryText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock x:Name="PeekBatteryGlyph" Style="{StaticResource Icon}" FontSize="17" Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ═══════════ ACTIVITY: short-lived system event ═══════════ -->
        <Grid x:Name="Activity" MinWidth="250" MinHeight="58" HorizontalAlignment="Center" VerticalAlignment="Top"
              Opacity="0" IsHitTestVisible="False" Background="Transparent" MouseLeftButtonUp="Activity_Click">
            <Grid.RenderTransform><TranslateTransform x:Name="ActivityDrop"/></Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="ActivityIcon" Width="34" Height="34" CornerRadius="17" Background="{StaticResource FillBrush}"
                    Margin="14,4,10,0" VerticalAlignment="Center">
                <Grid>
                    <TextBlock x:Name="ActivityGlyph" Style="{StaticResource Icon}" FontSize="15" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <controls:LineIcon x:Name="ActivityIcon2" Width="18" Height="18" Visibility="Collapsed"/>
                    <Image x:Name="ActivityAppIcon" Width="34" Height="34" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </Border>
            <StackPanel x:Name="ActivityText" Grid.Column="1" VerticalAlignment="Center" Margin="0,4,20,0">
                <TextBlock x:Name="ActivityCaption" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,1" Visibility="Collapsed"/>
                <TextBlock x:Name="ActivityTitle" FontSize="13" FontWeight="SemiBold" MaxWidth="300" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ActivityDetail" FontSize="11.5" Foreground="{StaticResource MutedBrush}" MaxWidth="230" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <ProgressBar x:Name="ActivityBar" Grid.Column="2" Width="64" Style="{StaticResource StatBar}" Foreground="{StaticResource TextBrush}"
                         Maximum="1" Margin="0,4,20,0" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>

        <!-- ═══════════ EXPANDED: hover ═══════════ -->
        <StackPanel x:Name="Expanded" Width="560" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Opacity="0" IsHitTestVisible="False">
            <StackPanel.RenderTransform><TranslateTransform x:Name="ExpandedDrop"/></StackPanel.RenderTransform>

            <!-- Status row: date/time · privacy · battery -->
            <Grid Margin="20,7,14,0" Height="26">
                <TextBlock x:Name="StatusClock" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SnipChip" Style="{StaticResource Chip}" Click="SnipChip_Click" ToolTip="Screenshot">
                        <TextBlock Text="&#xE722;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource TextBrush}"/>
                    </Button>
                    <Button x:Name="PrivacyChip" Style="{StaticResource Chip}" Click="PrivacyChip_Click" ToolTip="Privacy activity" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ChipCam" Text="&#xE714;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="ChipMic" Text="&#xE720;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource OrangeBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="In use" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BatteryChip" Style="{StaticResource Chip}" Click="BatteryChip_Click" ToolTip="Battery" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ChipBatteryText" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="ChipBatteryGlyph" Style="{StaticResource Icon}" FontSize="17" Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Chip panels (screenshot / battery / privacy): one at a time, right under the chips -->
            <Border x:Name="PanelHost" Background="{StaticResource PanelTileBrush}" CornerRadius="{StaticResource TileRadius}" Margin="12,8,12,2" Padding="14,12" Visibility="Collapsed">
                <Grid>
                    <!-- Screenshot -->
                    <StackPanel x:Name="SnipPanel" Visibility="Collapsed">
                        <TextBlock Text="Screenshot" Style="{StaticResource PanelTitle}"/>
                        <UniformGrid Columns="4" Margin="-3,0">
                            <Button Style="{StaticResource SmallTile}" Click="SnipRect_Click" ToolTip="Drag to select an area">
                                <StackPanel><TextBlock Text="&#xE7A8;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Rectangle" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource SmallTile}" Click="SnipWindow_Click" ToolTip="Click a window to capture it">
                                <StackPanel><TextBlock Text="&#xE737;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Window" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource SmallTile}" Click="SnipFull_Click" ToolTip="Every display, saved to Pictures\Screenshots">
                                <StackPanel><TextBlock Text="&#xE740;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Full screen" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource SmallTile}" Click="SnipApp_Click" ToolTip="Open Snipping Tool">
                                <StackPanel><TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Snipping Tool" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>

                    <!-- Battery -->
                    <StackPanel x:Name="BatteryPanel" Visibility="Collapsed">
                        <TextBlock Text="Battery" Style="{StaticResource PanelTitle}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="BatteryBig" Style="{StaticResource BigNumber}" FontSize="34"/>
                            <TextBlock x:Name="BatteryStatus" FontSize="12.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,4,0,0"/>
                        </StackPanel>
                        <ProgressBar x:Name="BatteryBar" Style="{StaticResource StatBar}" Maximum="100" Margin="0,8,0,0"/>
                        <DockPanel Margin="0,16,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Plugged in" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Last 24 hours" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                        </DockPanel>
                        <controls:BatteryChart x:Name="BatteryHistoryChart" Height="56" BarBrush="{StaticResource MutedBrush}" PluggedBrush="{StaticResource AccentBrush}"/>
                        <Grid Margin="0,4,0,0">
                            <TextBlock x:Name="BatteryChartStart" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="BatteryChartMiddle" FontSize="10.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Now" FontSize="10.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock x:Name="BatteryChartEmpty" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="The chart fills in while LapDock runs: one bar per half hour." Visibility="Collapsed"/>
                        <UniformGrid x:Name="BatteryHealthRow" Columns="3" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Health" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="BatteryHealthText" FontSize="15" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Full charge" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="BatteryCapacityText" FontSize="15" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="BatteryRateLabel" Text="Power" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="BatteryRateText" FontSize="15" FontWeight="SemiBold"/>
                            </StackPanel>
                        </UniformGrid>
                        <Button Content="Power &amp; battery settings" Style="{StaticResource Link}" Click="BatterySettings_Click"/>
                    </StackPanel>

                    <!-- Privacy -->
                    <StackPanel x:Name="PrivacyPanel" Visibility="Collapsed">
                        <TextBlock Text="Privacy" Style="{StaticResource PanelTitle}"/>
                        <Grid x:Name="PrivacyMicRow" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="PrivacyMicGlyph" Text="&#xE720;" Style="{StaticResource Icon}" FontSize="16"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Microphone" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="PrivacyMicText" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="PrivacyCamRow">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="PrivacyCamGlyph" Text="&#xE714;" Style="{StaticResource Icon}" FontSize="16"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Camera" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="PrivacyCamText" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <Button Content="Privacy settings" Style="{StaticResource Link}" Click="PrivacySettings_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- Tabs: everything the island does, one page at a time -->
            <TabControl x:Name="Tabs" Margin="12,6,12,0" Background="Transparent" BorderThickness="0" Padding="0"
                        SelectionChanged="Tabs_SelectionChanged">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <TabPanel DockPanel.Dock="Top" IsItemsHost="True" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </DockPanel>
                    </ControlTemplate>
                </TabControl.Template>

                <TabItem Header="Controls" Tag="controls"><tabs:ControlsTab x:Name="ControlsPage"/></TabItem>
                <TabItem x:Name="TodayTabItem" Header="Today" Tag="today"><tabs:TodayTab x:Name="TodayPage"/></TabItem>
                <TabItem x:Name="StatsTabItem" Header="Stats" Tag="stats"><tabs:StatsTab x:Name="StatsPage"/></TabItem>
                <TabItem x:Name="ClipboardTabItem" Header="Clipboard" Tag="clipboard"><tabs:ClipboardTab x:Name="ClipboardPage"/></TabItem>
                <TabItem x:Name="ShelfTabItem" Header="Shelf" Tag="shelf"><tabs:ShelfTab x:Name="ShelfPage"/></TabItem>
                <TabItem x:Name="AppsTabItem" Header="Apps" Tag="apps"><tabs:AppsTab x:Name="AppsPage"/></TabItem>
                <TabItem x:Name="WallpaperTabItem" Header="Wallpaper" Tag="wallpaper"><tabs:WallpaperTab x:Name="WallpaperPage"/></TabItem>
                <TabItem x:Name="PowerTabItem" Header="Power" Tag="power"><tabs:PowerTab x:Name="PowerPage"/></TabItem>
            </TabControl>
            <Border Height="14"/>
        </StackPanel>
    </Grid>
</Window>
