<Window x:Class="LapDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LapDock.Controls"
        Title="LapDock" Width="1340" Height="820" MinWidth="980" MinHeight="640"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="#0B0E14" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI" KeyDown="OnKeyDown">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.25,0.1" GradientOrigin="0.25,0.1" RadiusX="1.1" RadiusY="1.1">
                <GradientStop Color="#131B30" Offset="0"/>
                <GradientStop Color="#0B0E14" Offset="0.65"/>
            </RadialGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════ TOP BAR (drag to move) ══════════ -->
        <Grid Grid.Row="0" Margin="14,10,14,2" MouseLeftButtonDown="TopBar_MouseDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⬢ LAPDOCK" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="  ·  your laptop screen, alive" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Show on:" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="ScreenPicker" Width="240" Height="30" VerticalContentAlignment="Center"
                          SelectionChanged="ScreenPicker_SelectionChanged"/>
                <Button Content="📌" Style="{StaticResource RoundButton}" Width="36" Height="36" Margin="10,0,4,0"
                        ToolTip="Always on top" Click="Pin_Click"/>
                <Button Content="—" Style="{StaticResource RoundButton}" Width="36" Height="36" Margin="0,0,4,0"
                        ToolTip="Minimise" Click="Minimise_Click"/>
                <Button Content="⛶" Style="{StaticResource RoundButton}" Width="36" Height="36" Margin="0,0,4,0"
                        ToolTip="Fullscreen (F11)" Click="Fullscreen_Click"/>
                <Button Content="✕" Style="{StaticResource RoundButton}" Width="36" Height="36"
                        ToolTip="Close LapDock" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <!-- ══════════ CONTENT ══════════ -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Nova + Music -->
            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource Card}">
                    <StackPanel HorizontalAlignment="Center">
                        <controls:CompanionHead x:Name="Nova" HorizontalAlignment="Center"/>
                        <Border Background="#1E2637" CornerRadius="14" Padding="12,8" Margin="0,2,0,4" MaxWidth="290">
                            <TextBlock x:Name="BubbleText" Text="👀 I'm watching your cursor…" FontSize="13.5"
                                       TextWrapping="Wrap" TextAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="MoodText" Text="Nova is awake" Foreground="{StaticResource MutedBrush}"
                                   FontSize="11.5" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="🎵  MUSIC" Style="{StaticResource CardTitle}"/>
                        <StackPanel Orientation="Horizontal" Height="30" VerticalAlignment="Bottom" Margin="0,0,0,6">
                            <Rectangle x:Name="Eq1" Width="7" Height="6" Fill="{StaticResource AccentBrush}" RadiusX="2" RadiusY="2" Margin="0,0,4,0" VerticalAlignment="Bottom"/>
                            <Rectangle x:Name="Eq2" Width="7" Height="6" Fill="{StaticResource AccentBrush}" RadiusX="2" RadiusY="2" Margin="0,0,4,0" VerticalAlignment="Bottom"/>
                            <Rectangle x:Name="Eq3" Width="7" Height="6" Fill="#7C5CFF" RadiusX="2" RadiusY="2" Margin="0,0,4,0" VerticalAlignment="Bottom"/>
                            <Rectangle x:Name="Eq4" Width="7" Height="6" Fill="#7C5CFF" RadiusX="2" RadiusY="2" Margin="0,0,4,0" VerticalAlignment="Bottom"/>
                            <Rectangle x:Name="Eq5" Width="7" Height="6" Fill="{StaticResource AccentBrush}" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom"/>
                            <TextBlock x:Name="MediaStatus" Text="  Press play — works with Spotify, YouTube, VLC…"
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="⏮" Style="{StaticResource RoundButton}" ToolTip="Previous track" Click="Prev_Click"/>
                            <Button x:Name="PlayButton" Content="▶" Style="{StaticResource RoundButton}" Width="58" Height="58" FontSize="22" Margin="10,0" ToolTip="Play / pause" Click="PlayPause_Click"/>
                            <Button Content="⏭" Style="{StaticResource RoundButton}" ToolTip="Next track" Click="Next_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button Content="🔉" Style="{StaticResource RoundButton}" Width="38" Height="38" FontSize="14" ToolTip="Volume down" Click="VolDown_Click"/>
                            <Button Content="🔇" Style="{StaticResource RoundButton}" Width="38" Height="38" FontSize="14" Margin="8,0" ToolTip="Mute" Click="Mute_Click"/>
                            <Button Content="🔊" Style="{StaticResource RoundButton}" Width="38" Height="38" FontSize="14" ToolTip="Volume up" Click="VolUp_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- RIGHT: clock + widgets -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding ClockText}" FontSize="76" FontWeight="SemiBold" LineHeight="80"/>
                            <TextBlock Text="{Binding DateText}" Foreground="{StaticResource MutedBrush}" FontSize="15"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="WeatherText" Text="🌡️ …" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="WeatherCity" Text="" Foreground="{StaticResource MutedBrush}" FontSize="12.5" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Pomodoro -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="🍅  POMODORO" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{Binding PomoPhase}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PomoDisplay}" FontSize="46" FontWeight="SemiBold" Margin="0,2"/>
                            <ProgressBar Style="{StaticResource StatBar}" Minimum="0" Maximum="1" Value="{Binding PomoProgress}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="{Binding PomoButtonText}" Padding="16,8" Click="PomoStartPause_Click"/>
                                <Button Content="Reset" Padding="16,8" Margin="8,0,0,0" Click="PomoReset_Click"/>
                                <TextBlock Text="{Binding PomoDoneText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- System -->
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="📊  SYSTEM" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="CpuText" Text="CPU —" FontSize="13"/>
                            <ProgressBar x:Name="CpuBar" Style="{StaticResource StatBar}" Maximum="100" Margin="0,4,0,10"/>
                            <TextBlock x:Name="RamText" Text="RAM —" FontSize="13"/>
                            <ProgressBar x:Name="RamBar" Style="{StaticResource StatBar}" Maximum="100" Margin="0,4,0,10"/>
                            <TextBlock x:Name="BattText" Text="Battery —" FontSize="13"/>
                            <ProgressBar x:Name="BattBar" Style="{StaticResource StatBar}" Maximum="100" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Timers -->
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="⏱️  TIMERS" Style="{StaticResource CardTitle}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Countdown" FontSize="13" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding CountdownInput}" Width="46" Margin="8,0" Padding="4,2"
                                         Background="#1E2637" Foreground="{StaticResource TextBrush}" BorderThickness="0"/>
                                <TextBlock Text="min" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CountDisplay}" FontSize="30" FontWeight="SemiBold" Margin="0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding CountButtonText}" Padding="14,6" Click="CountStartPause_Click"/>
                                <Button Content="Reset" Padding="14,6" Margin="8,0,0,0" Click="CountReset_Click"/>
                            </StackPanel>
                            <TextBlock Text="Stopwatch" FontSize="13" Margin="0,14,0,0"/>
                            <TextBlock Text="{Binding WatchDisplay}" FontSize="30" FontWeight="SemiBold" Margin="0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding WatchButtonText}" Padding="14,6" Click="WatchStartPause_Click"/>
                                <Button Content="Reset" Padding="14,6" Margin="8,0,0,0" Click="WatchReset_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Notes + quick actions -->
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="📝  SCRATCH NOTES" Style="{StaticResource CardTitle}"/>
                                <TextBox x:Name="NotesBox" Height="86" AcceptsReturn="True" TextWrapping="Wrap"
                                         Background="#11151F" Foreground="{StaticResource TextBrush}" BorderThickness="0"
                                         Padding="8" VerticalScrollBarVisibility="Auto"
                                         TextChanged="NotesBox_TextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                <TextBlock Text="⚡  QUICK ACTIONS" Style="{StaticResource CardTitle}"/>
                                <WrapPanel>
                                    <Button Content="🔒 Lock" Padding="12,7" Margin="0,0,6,6" Click="Lock_Click"/>
                                    <Button Content="📸 Snip" Padding="12,7" Margin="0,0,6,6" Click="Snip_Click"/>
                                    <Button Content="🗔 Tasks" Padding="12,7" Margin="0,0,6,6" Click="TaskMgr_Click"/>
                                    <Button Content="🌙 Focus" Padding="12,7" Margin="0,0,6,6" Click="Focus_Click"/>
                                    <Button Content="🖥️ Display" Padding="12,7" Margin="0,0,6,6" Click="DisplaySettings_Click"/>
                                    <Button Content="🔊 Sound" Padding="12,7" Margin="0,0,0,6" Click="SoundSettings_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ══════════ BOTTOM DOCK ══════════ -->
        <Border Grid.Row="2" HorizontalAlignment="Center" Margin="0,2,0,14"
                Background="#141926" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                CornerRadius="22" Padding="10,8">
            <StackPanel x:Name="DockPanel" Orientation="Horizontal"/>
        </Border>
    </Grid>
</Window>
