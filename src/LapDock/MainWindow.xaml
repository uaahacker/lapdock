<Window x:Class="LapDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LapDock" Width="480" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="SectionBrush" Color="#161618"/>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Control-Centre tile: glyph over a small label. Tag="on" = selected. -->
        <Style x:Key="ToolTile" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource TileTemplate}"/>
            <Setter Property="Background" Value="{StaticResource FillBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Width" Value="84"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="on"><Setter Property="Background" Value="{StaticResource AccentBrush}"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SmallTile" TargetType="Button" BasedOn="{StaticResource ActionTile}">
            <Setter Property="Height" Value="58"/>
            <Setter Property="Background" Value="{StaticResource FillBrush}"/>
        </Style>

        <!-- Status chips in the top row (battery, privacy) -->
        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="-8,6,0,0"/>
        </Style>

        <!-- Small selectable pill (wallpaper fit style). Tag="on" = selected. -->
        <Style x:Key="OptionPill" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,5,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="on">
                    <Setter Property="Background" Value="{StaticResource TextBrush}"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Volume: like the seek bar, but the knob is always there to grab -->
        <Style x:Key="VolumeSlider" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22" Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SeekPart}" Background="{StaticResource AccentBrush}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SeekPart}" Background="{StaticResource FillHoverBrush}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb"><Ellipse Fill="{StaticResource TextBrush}"/></ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The window is fully transparent (and so click-through); only the island is drawn.
         Three states share one black pill: Peek (collapsed), Activity (short-lived event), Expanded (hover). -->
    <Grid x:Name="Island" HorizontalAlignment="Center" VerticalAlignment="Top"
          MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
          AllowDrop="True" DragOver="Island_DragOver" DragLeave="Island_DragLeave" Drop="Island_Drop">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Move to next display" Click="NextDisplay_Click"/>
                <MenuItem Header="Quit LapDock" Click="Quit_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <Border x:Name="Pill" Background="Black" CornerRadius="0,0,22,22" Width="190" Height="32"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="0"
                HorizontalAlignment="Center" VerticalAlignment="Top"/>

        <!-- ═══════════ PEEK: collapsed notch ═══════════ -->
        <Grid x:Name="Peek" MinWidth="190" Height="32" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="18"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="18,0,0,1" VerticalAlignment="Center">
                <Border x:Name="PeekArt" Width="18" Height="18" CornerRadius="4" Margin="0,0,8,0" Visibility="Collapsed">
                    <Border.Background><ImageBrush x:Name="PeekArtBrush" Stretch="UniformToFill"/></Border.Background>
                </Border>
                <TextBlock x:Name="PeekTitle" MaxWidth="150" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
                <TextBlock x:Name="PeekTime" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,18,1" VerticalAlignment="Center">
                <StackPanel x:Name="PeekEq" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed">
                    <Rectangle x:Name="Eq1" Width="2.5" Height="4" RadiusX="1.25" RadiusY="1.25" Fill="{StaticResource GreenBrush}" Margin="0,0,2,0"/>
                    <Rectangle x:Name="Eq2" Width="2.5" Height="4" RadiusX="1.25" RadiusY="1.25" Fill="{StaticResource GreenBrush}" Margin="0,0,2,0"/>
                    <Rectangle x:Name="Eq3" Width="2.5" Height="4" RadiusX="1.25" RadiusY="1.25" Fill="{StaticResource GreenBrush}" Margin="0,0,2,0"/>
                    <Rectangle x:Name="Eq4" Width="2.5" Height="4" RadiusX="1.25" RadiusY="1.25" Fill="{StaticResource GreenBrush}"/>
                </StackPanel>
                <!-- iOS privacy dots: green = camera, orange = microphone -->
                <Ellipse x:Name="PeekCamDot" Width="7" Height="7" Fill="{StaticResource GreenBrush}" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                <Ellipse x:Name="PeekMicDot" Width="7" Height="7" Fill="{StaticResource OrangeBrush}" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                <StackPanel x:Name="PeekBattery" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock x:Name="PeekBatteryText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock x:Name="PeekBatteryGlyph" Style="{StaticResource Icon}" FontSize="17" Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ═══════════ ACTIVITY: short-lived system event ═══════════ -->
        <Grid x:Name="Activity" MinWidth="250" Height="58" HorizontalAlignment="Center" VerticalAlignment="Top"
              Opacity="0" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="ActivityIcon" Width="34" Height="34" CornerRadius="17" Background="{StaticResource FillBrush}"
                    Margin="14,4,10,0" VerticalAlignment="Center">
                <TextBlock x:Name="ActivityGlyph" Style="{StaticResource Icon}" FontSize="15" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,4,0,0">
                <TextBlock x:Name="ActivityTitle" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock x:Name="ActivityDetail" FontSize="11.5" Foreground="{StaticResource MutedBrush}" MaxWidth="230" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <ProgressBar x:Name="ActivityBar" Grid.Column="2" Width="64" Style="{StaticResource StatBar}" Foreground="{StaticResource TextBrush}"
                         Maximum="1" Margin="12,4,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
            <Border Grid.Column="2" Width="18" HorizontalAlignment="Right"/>
        </Grid>

        <!-- ═══════════ EXPANDED: hover ═══════════ -->
        <StackPanel x:Name="Expanded" Width="440" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Opacity="0" IsHitTestVisible="False">

            <!-- Status row: date/time · privacy · battery -->
            <Grid Margin="20,7,14,0" Height="26">
                <TextBlock x:Name="StatusClock" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PrivacyChip" Style="{StaticResource Chip}" Click="PrivacyChip_Click" ToolTip="Privacy activity" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ChipCam" Text="&#xE714;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource GreenBrush}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="ChipMic" Text="&#xE720;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource OrangeBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="In use" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BatteryChip" Style="{StaticResource Chip}" Click="BatteryChip_Click" ToolTip="Battery" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ChipBatteryText" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="ChipBatteryGlyph" Style="{StaticResource Icon}" FontSize="17" Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Pinned apps -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,4">
                <StackPanel x:Name="DockPanel" Orientation="Horizontal"/>
                <!-- Shown while dragging an app over the notch: where it will be pinned -->
                <Rectangle x:Name="DropSlot" Width="52" Height="52" RadiusX="12" RadiusY="12" Margin="6,0"
                           Stroke="{StaticResource AccentBrush}" StrokeThickness="2" StrokeDashArray="3 2" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Now playing -->
            <Border x:Name="MediaCard" Background="{StaticResource SectionBrush}" CornerRadius="16" Margin="12,8,12,0" Padding="12" Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid Width="56" Height="56">
                            <Border Background="{StaticResource FillBrush}" CornerRadius="10">
                                <TextBlock Text="&#xE8D6;" Style="{StaticResource Icon}" FontSize="20" Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center"/>
                            </Border>
                            <Border CornerRadius="10">
                                <Border.Background><ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill"/></Border.Background>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                            <TextBlock Text="{Binding Artist}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                    <Slider x:Name="SeekBar" Style="{StaticResource SeekSlider}" Minimum="0" IsMoveToPointEnabled="True" IsEnabled="False" Margin="0,10,0,0"
                            PreviewMouseLeftButtonDown="SeekBar_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="SeekBar_PreviewMouseLeftButtonUp"
                            LostMouseCapture="SeekBar_LostMouseCapture"/>
                    <Grid>
                        <TextBlock Text="{Binding PositionText}" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="{Binding DurationText}" FontSize="10.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <Button Content="&#xF8AC;" Style="{StaticResource GhostRound}" Width="40" Height="40" FontSize="16" ToolTip="Previous" Click="Prev_Click"/>
                        <Button x:Name="PlayButton" Content="&#xF5B0;" Style="{StaticResource RoundButton}" Width="44" Height="44" FontSize="16"
                                Background="{StaticResource TextBrush}" Foreground="Black" Margin="14,0" ToolTip="Play / pause" Click="PlayPause_Click"/>
                        <Button Content="&#xF8AD;" Style="{StaticResource GhostRound}" Width="40" Height="40" FontSize="16" ToolTip="Next" Click="Next_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Tools: each opens its panel below -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button x:Name="SnipTool" Style="{StaticResource ToolTile}" Click="SnipTool_Click" ToolTip="Screenshot">
                    <StackPanel>
                        <TextBlock Text="&#xE7A8;" Style="{StaticResource Icon}" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Screenshot" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="VolumeTool" Style="{StaticResource ToolTile}" Click="VolumeTool_Click" ToolTip="Volume">
                    <StackPanel>
                        <TextBlock x:Name="VolumeToolGlyph" Text="&#xE995;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="VolumeToolText" Text="Volume" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="WallpaperTool" Style="{StaticResource ToolTile}" Click="WallpaperTool_Click" ToolTip="Wallpaper">
                    <StackPanel>
                        <TextBlock Text="&#xE91B;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Wallpaper" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Detail panel: one at a time -->
            <Border x:Name="PanelHost" Background="{StaticResource SectionBrush}" CornerRadius="16" Margin="12,10,12,0" Padding="14,12" Visibility="Collapsed">
                <Grid>
                    <!-- Screenshot -->
                    <StackPanel x:Name="SnipPanel" Visibility="Collapsed">
                        <TextBlock Text="Screenshot" Style="{StaticResource PanelTitle}"/>
                        <UniformGrid Columns="4" Margin="-3,0">
                            <Button Style="{StaticResource SmallTile}" Click="SnipRect_Click" ToolTip="Drag to select an area">
                                <StackPanel><TextBlock Text="&#xE7A8;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Rectangle" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource SmallTile}" Click="SnipWindow_Click" ToolTip="Click a window to capture it">
                                <StackPanel><TextBlock Text="&#xE737;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Window" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource SmallTile}" Click="SnipFull_Click" ToolTip="Every display, saved to Pictures\Screenshots">
                                <StackPanel><TextBlock Text="&#xE740;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Full screen" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource SmallTile}" Click="SnipApp_Click" ToolTip="Open Snipping Tool">
                                <StackPanel><TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Snipping Tool" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>

                    <!-- Volume -->
                    <StackPanel x:Name="VolumePanel" Visibility="Collapsed">
                        <Grid>
                            <TextBlock Text="Volume" Style="{StaticResource PanelTitle}"/>
                            <TextBlock x:Name="VolumeValue" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button x:Name="MuteButton" Content="&#xE995;" Style="{StaticResource RoundButton}" Width="36" Height="36" FontSize="14"
                                    ToolTip="Mute / unmute" Click="Mute_Click"/>
                            <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="100"
                                    IsMoveToPointEnabled="True" Margin="12,0,4,0" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                        </Grid>
                        <Button Content="Sound settings" Style="{StaticResource Link}" Click="SoundSettings_Click"/>
                    </StackPanel>

                    <!-- Wallpaper -->
                    <StackPanel x:Name="WallpaperPanel" Visibility="Collapsed">
                        <TextBlock Text="Wallpaper" Style="{StaticResource PanelTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Style="{StaticResource DockIcon}" Click="WallpaperPreview_Click" ToolTip="Open background settings">
                                <Grid Width="150" Height="84">
                                    <Border Background="{StaticResource FillBrush}" CornerRadius="10">
                                        <TextBlock Text="&#xE91B;" Style="{StaticResource Icon}" FontSize="20" Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border CornerRadius="10" BorderBrush="#2A2A2E" BorderThickness="1">
                                        <Border.Background><ImageBrush x:Name="WallpaperPreview" Stretch="UniformToFill"/></Border.Background>
                                    </Border>
                                </Grid>
                            </Button>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="Current" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="WallpaperName" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,1,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Change…" Style="{StaticResource PrimaryPill}" Padding="12,5" FontSize="12" Click="WallpaperBrowse_Click"/>
                                    <Button Content="Next" Style="{StaticResource PillButton}" Padding="12,5" FontSize="12" Margin="6,0,0,0" Click="WallpaperNext_Click"
                                            ToolTip="Next picture in the same folder (or in Recent)"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <WrapPanel x:Name="WallpaperStyles" Margin="0,10,0,0"/>
                        <TextBlock x:Name="RecentLabel" Text="Recent" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,5"/>
                        <StackPanel x:Name="RecentWallpapers" Orientation="Horizontal"/>
                        <TextBlock x:Name="WallpaperStatus" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Battery -->
                    <StackPanel x:Name="BatteryPanel" Visibility="Collapsed">
                        <TextBlock Text="Battery" Style="{StaticResource PanelTitle}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="BatteryBig" Style="{StaticResource BigNumber}" FontSize="34"/>
                            <TextBlock x:Name="BatteryStatus" FontSize="12.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,4,0,0"/>
                        </StackPanel>
                        <ProgressBar x:Name="BatteryBar" Style="{StaticResource StatBar}" Maximum="100" Margin="0,8,0,0"/>
                        <Button Content="Power &amp; battery settings" Style="{StaticResource Link}" Click="BatterySettings_Click"/>
                    </StackPanel>

                    <!-- Privacy -->
                    <StackPanel x:Name="PrivacyPanel" Visibility="Collapsed">
                        <TextBlock Text="Privacy" Style="{StaticResource PanelTitle}"/>
                        <Grid x:Name="PrivacyMicRow" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="PrivacyMicGlyph" Text="&#xE720;" Style="{StaticResource Icon}" FontSize="16"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Microphone" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="PrivacyMicText" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="PrivacyCamRow">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="PrivacyCamGlyph" Text="&#xE714;" Style="{StaticResource Icon}" FontSize="16"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Camera" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="PrivacyCamText" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <Button Content="Privacy settings" Style="{StaticResource Link}" Click="PrivacySettings_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Height="14"/>
        </StackPanel>
    </Grid>
</Window>
