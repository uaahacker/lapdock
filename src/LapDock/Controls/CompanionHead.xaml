<UserControl x:Class="LapDock.Controls.CompanionHead"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="260" Height="280" Cursor="Hand"
             ToolTip="Poke Nova!">
    <!-- Nova: a clean little robot head drawn entirely in vector shapes.
         Eyes / pupils / brows / mouth are named so the code-behind can
         animate them from the global cursor position. -->
    <Grid>
        <Grid x:Name="HeadRoot" RenderTransformOrigin="0.5,0.6">
            <Grid.RenderTransform>
                <TransformGroup>
                    <RotateTransform x:Name="HeadTilt"/>
                    <TranslateTransform x:Name="HeadLean"/>
                </TransformGroup>
            </Grid.RenderTransform>

            <Canvas Width="260" Height="280">
                <!-- Antenna -->
                <Rectangle Canvas.Left="127" Canvas.Top="22" Width="6" Height="24" RadiusX="3" RadiusY="3" Fill="#3A3A3C"/>
                <Ellipse Canvas.Left="121" Canvas.Top="4" Width="18" Height="18">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#6AB4FF" Offset="0"/>
                            <GradientStop Color="#0A84FF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Head shell -->
                <Border Canvas.Left="28" Canvas.Top="44" Width="204" Height="196" CornerRadius="64">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2E2E31" Offset="0"/>
                            <GradientStop Color="#151517" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#0A84FF" BlurRadius="40" ShadowDepth="0" Opacity="0.22"/>
                    </Border.Effect>
                </Border>

                <!-- Cheeks -->
                <Ellipse Canvas.Left="52" Canvas.Top="168" Width="26" Height="14" Fill="#FF8FA3" Opacity="0.4"/>
                <Ellipse Canvas.Left="182" Canvas.Top="168" Width="26" Height="14" Fill="#FF8FA3" Opacity="0.4"/>

                <!-- Brows -->
                <Border x:Name="BrowL" Canvas.Left="72" Canvas.Top="102" Width="38" Height="8" CornerRadius="4"
                        Background="#E5E5EA" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><RotateTransform x:Name="BrowLRot"/></Border.RenderTransform>
                </Border>
                <Border x:Name="BrowR" Canvas.Left="150" Canvas.Top="102" Width="38" Height="8" CornerRadius="4"
                        Background="#E5E5EA" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><RotateTransform x:Name="BrowRRot"/></Border.RenderTransform>
                </Border>

                <!-- Eyes (white + pupil + sparkle). ScaleY on the root = blink. -->
                <Grid x:Name="EyeL" Canvas.Left="68" Canvas.Top="118" Width="46" Height="58" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform x:Name="EyeLScale"/></Grid.RenderTransform>
                    <Ellipse Fill="White"/>
                    <Ellipse Width="22" Height="26" Fill="#0B0B0C">
                        <Ellipse.RenderTransform><TranslateTransform x:Name="PupilL"/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Width="7" Height="7" Fill="White" Margin="-10,-12,0,0">
                        <Ellipse.RenderTransform><TranslateTransform x:Name="SparkL"/></Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
                <Grid x:Name="EyeR" Canvas.Left="146" Canvas.Top="118" Width="46" Height="58" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform x:Name="EyeRScale"/></Grid.RenderTransform>
                    <Ellipse Fill="White"/>
                    <Ellipse Width="22" Height="26" Fill="#0B0B0C">
                        <Ellipse.RenderTransform><TranslateTransform x:Name="PupilR"/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Width="7" Height="7" Fill="White" Margin="-10,-12,0,0">
                        <Ellipse.RenderTransform><TranslateTransform x:Name="SparkR"/></Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>

                <!-- Mouth: path data is swapped per mood in code-behind -->
                <Path x:Name="MouthPath" Canvas.Left="110" Canvas.Top="192"
                      Stroke="#EDF1F7" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M0,0 Q20,16 40,0"/>

                <!-- Sleepy Zzz -->
                <TextBlock x:Name="ZzzText" Canvas.Left="216" Canvas.Top="18" Text="Z z z"
                           Foreground="#8E8E93" FontSize="18" FontWeight="Bold" Opacity="0"/>
            </Canvas>
        </Grid>
    </Grid>
</UserControl>
