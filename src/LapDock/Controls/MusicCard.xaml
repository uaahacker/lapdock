<UserControl x:Class="LapDock.Controls.MusicCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LapDock.Controls"
             Foreground="{StaticResource TextBrush}">
    <!-- Now playing (SMTC): artwork, title/artist, seek bar, transport. Shared by the notch and the
         panel's Controls tab; each host sets Background + Padding. -->
    <UserControl.Template>
        <ControlTemplate TargetType="UserControl">
            <Border Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                <ContentPresenter/>
            </Border>
        </ControlTemplate>
    </UserControl.Template>

    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Width="56" Height="56">
                <Border Background="#33FFFFFF" CornerRadius="10">
                    <local:LineIcon Icon="music" Width="28" Height="28" Foreground="{StaticResource MutedBrush}"/>
                </Border>
                <Border CornerRadius="10">
                    <Border.Background><ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill"/></Border.Background>
                </Border>
            </Grid>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                <TextBlock Text="{Binding Artist}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>
        <StackPanel x:Name="SeekRow">
            <Slider x:Name="SeekBar" Style="{StaticResource SeekSlider}" Minimum="0" IsMoveToPointEnabled="True" IsEnabled="False" Margin="0,10,0,0"
                    PreviewMouseLeftButtonDown="SeekBar_PreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="SeekBar_PreviewMouseLeftButtonUp"
                    LostMouseCapture="SeekBar_LostMouseCapture"/>
            <Grid>
                <TextBlock Text="{Binding PositionText}" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="{Binding DurationText}" FontSize="10.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
            <Button Style="{StaticResource GhostRound}" Width="40" Height="40" ToolTip="Previous" Click="Prev_Click">
                <local:LineIcon Icon="prev" Width="23" Height="23"/>
            </Button>
            <Button x:Name="PlayButton" Style="{StaticResource RoundButton}" Width="44" Height="44"
                    Background="{StaticResource PanelFillBrush}" Margin="14,0" ToolTip="Play / pause" Click="PlayPause_Click">
                <local:LineIcon x:Name="PlayIcon" Icon="play" Width="23" Height="23"/>
            </Button>
            <Button Style="{StaticResource GhostRound}" Width="40" Height="40" ToolTip="Next" Click="Next_Click">
                <local:LineIcon Icon="next" Width="23" Height="23"/>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
